<Window x:Class="AlphaNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="α · 原生 Markdown 编辑器"
        Width="1400" Height="900" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0">
                        <TextBlock Text="α" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="α" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="原生 Windows · Markdown + LaTeX" Foreground="{DynamicResource MutedBrush}" FontSize="10" />
                    </StackPanel>
                    <Button Content="新建" Click="New_Click" />
                    <Button Content="打开" Click="Open_Click" Style="{StaticResource PrimaryButton}" ToolTip="打开一个或多个 Markdown 文件（Ctrl+O）" />
                    <Button Content="保存" Click="Save_Click" />
                    <Button Content="另存为" Click="SaveAs_Click" />
                    
<Button x:Name="InsertMenuButton" Content="插入 ▾" Click="InsertMenu_Click" ToolTip="插入 Markdown 格式与内容" Style="{StaticResource ToolbarDropDownButton}" />
<Popup x:Name="InsertPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
    <Border Width="540" MaxHeight="610" Margin="0,6,0,0" Padding="14" CornerRadius="16" Background="{DynamicResource PopupSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="标题" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,8" />
            <WrapPanel>
                <Button Tag="h1" Click="Format_Click" Style="{StaticResource InsertCardButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="H1" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="一级标题" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="h2" Click="Format_Click" Style="{StaticResource InsertCardButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="H2" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="二级标题" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="h3" Click="Format_Click" Style="{StaticResource InsertCardButton}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="H3" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="三级标题" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Border Height="1" Background="{DynamicResource PopupDividerBrush}" Margin="2,2,2,8" />
            <TextBlock Text="文本格式" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,8" />
            <WrapPanel>
                <Button Tag="bold" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="B" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="粗体" FontSize="14"/></StackPanel>
                </Button>
                <Button Tag="italic" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="I" FontStyle="Italic" FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="斜体" FontSize="14"/></StackPanel>
                </Button>
                <Button Tag="strike" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="S" TextDecorations="Strikethrough" FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="删除线" FontSize="14"/></StackPanel>
                </Button>
                <Button Tag="inlineCode" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&lt;/&gt;" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="行内代码" FontSize="14"/></StackPanel>
                </Button>
            </WrapPanel>

            <Border Height="1" Background="{DynamicResource PopupDividerBrush}" Margin="2,2,2,8" />
            <TextBlock Text="内容块" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,8" />
            <WrapPanel>
                <Button Tag="quote" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48"><StackPanel Orientation="Horizontal"><TextBlock Text=">" FontSize="22" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="引用" FontSize="14"/></StackPanel></Button>
                <Button Tag="ul" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48"><StackPanel Orientation="Horizontal"><TextBlock Text="•" FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="无序列表" FontSize="14"/></StackPanel></Button>
                <Button Tag="ol" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48"><StackPanel Orientation="Horizontal"><TextBlock Text="1." FontSize="17" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="有序列表" FontSize="14"/></StackPanel></Button>
                <Button Tag="task" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="☑" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="任务列表" FontSize="14"/></StackPanel></Button>
                <Button Tag="link" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48"><StackPanel Orientation="Horizontal"><TextBlock Text="↗" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="链接" FontSize="14"/></StackPanel></Button>
                <Button Tag="image" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48"><StackPanel Orientation="Horizontal"><TextBlock Text="▨" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="图片" FontSize="14"/></StackPanel></Button>
                <Button Tag="code" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48"><StackPanel Orientation="Horizontal"><TextBlock Text="&#123;&#125;" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="代码块" FontSize="14"/></StackPanel></Button>
                <Button Tag="table" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="121" Height="48" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="表格" FontSize="14"/></StackPanel></Button>
            </WrapPanel>

            <Border Height="1" Background="{DynamicResource PopupDividerBrush}" Margin="2,2,2,8" />
            <TextBlock Text="数学公式" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,8" />
            <WrapPanel>
                <Button Tag="inlineMath" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="160" Height="50"><StackPanel Orientation="Horizontal"><TextBlock Text="$...$" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="行内公式" FontSize="14"/></StackPanel></Button>
                <Button Tag="blockMath" Click="Format_Click" Style="{StaticResource InsertCardButton}" Width="160" Height="50"><StackPanel Orientation="Horizontal"><TextBlock Text="$$...$$" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="块级公式" FontSize="14"/></StackPanel></Button>
                <Button Tag="formulaLibrary" Click="FormulaLibrary_Click" Style="{StaticResource InsertCardButton}" Width="160" Height="50" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="ƒx" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,14,0"/><TextBlock Text="公式库" FontSize="14"/></StackPanel></Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</Popup>
<Button Content="查找" Click="Find_Click" ToolTip="查找文本（Ctrl+F）" />
                    
<Button x:Name="ExportMenuButton" Content="导出 ▾" Click="ExportMenu_Click" ToolTip="导出为 HTML 或 PDF" Style="{StaticResource ToolbarDropDownButton}" />
<Popup x:Name="ExportPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
    <Border Width="360" Margin="0,6,0,0" CornerRadius="16" Background="{DynamicResource PopupSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel Margin="8">
            <Button Click="ExportPdf_Click" Style="{StaticResource ExportRowButton}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PDF" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="导出 PDF" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="保存为 A4 PDF；浏览器会打开系统打印窗口" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Border Height="1" Background="{DynamicResource PopupDividerBrush}" Margin="8,1"/>
            <Button Click="ExportHtml_Click" Style="{StaticResource ExportRowButton}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="HTML" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="导出 HTML" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="生成可在浏览器中独立打开的网页文件" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Popup>

                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="WheelSpeedButton" Content="滚轮：3 行 ▾" Click="WheelSpeedMenu_Click"
                            ToolTip="设置每格滚轮移动的 Markdown 行数" Margin="0,0,8,0">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="精细：每格 1 行" Tag="one"
                                          IsCheckable="True" Click="WheelSpeedOption_Click" />
                                <MenuItem Header="标准：每格 3 行" Tag="three"
                                          IsCheckable="True" IsChecked="True" Click="WheelSpeedOption_Click" />
                                <MenuItem Header="快速：每格 5 行" Tag="five"
                                          IsCheckable="True" Click="WheelSpeedOption_Click" />
                                <Separator />
                                <MenuItem Header="显示编辑器行号" Tag="lineNumbers"
                                          IsCheckable="True" Click="ShowLineNumbers_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="NavigationButton" Content="导航" Click="Navigation_Click"
                            ToolTip="显示或隐藏阅读导航（Ctrl+Shift+O）" Margin="0,0,8,0" Style="{StaticResource ToolbarDropDownButton}" />
                    <CheckBox x:Name="SyncScrollCheck" Content="同步滚动" VerticalAlignment="Center" Margin="6,0,10,0"
                              ToolTip="编辑区与预览区双向同步滚动"
                              IsChecked="True" Checked="SyncScroll_Changed" Unchecked="SyncScroll_Changed" />
                    <Button x:Name="EditorViewButton" Content="编辑" Tag="editor" Click="ViewMode_Click" />
                    <Button x:Name="SplitViewButton" Content="分栏" Tag="split" Click="ViewMode_Click" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="PreviewViewButton" Content="预览" Tag="preview" Click="ViewMode_Click" />
                    <Button x:Name="ThemeButton" Content="深色" Click="Theme_Click" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>


        <Border Grid.Row="1" Background="{DynamicResource PanelAltBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="DocumentTabsScroll" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DocumentTabPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                </ScrollViewer>
                <Button Grid.Column="1" Content="＋" Click="New_Click" Style="{StaticResource ToolbarButton}"
                        Width="34" MinWidth="34" Padding="0" Margin="8,4,0,4" ToolTip="新建标签页（Ctrl+N）" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BorderBrush}">
            <Grid x:Name="WorkspaceGrid" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="230" MinWidth="0" />
                    <ColumnDefinition x:Name="NavigationSplitterColumn" Width="5" />
                    <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="280" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Border x:Name="NavigationPane" Grid.Column="0" Background="{DynamicResource PanelBackground}" Margin="6" CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Background="{DynamicResource PopupSurfaceAltBrush}" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="×" Click="Navigation_Click"
                                    Style="{StaticResource ToolbarButton}" Width="28" MinWidth="28" Padding="0" Margin="0,4,6,4"
                                    ToolTip="隐藏阅读导航（Ctrl+Shift+O）" />
                            <TextBlock DockPanel.Dock="Right" x:Name="NavigationCountText" Text="0 个标题" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock Text="阅读导航" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="NavigationItemsPanel" Margin="8,10,8,14" />
                            </ScrollViewer>
                            <TextBlock x:Name="NavigationEmptyText" Text="当前文档没有标题"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="NavigationSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                <Border x:Name="EditorPane" Grid.Column="2" Background="{DynamicResource PanelBackground}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Background="{DynamicResource PopupSurfaceAltBrush}" LastChildFill="True" Margin="0,0,0,1">
                            <TextBlock Text="MARKDOWN 编辑" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="FileNameText" Text="未命名.md" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </DockPanel>
                        <avalon:TextEditor x:Name="Editor" Grid.Row="1"
                                           ShowLineNumbers="False"
                                           ScrollViewer.IsDeferredScrollingEnabled="True"
                                           FontFamily="Segoe UI, Microsoft YaHei UI"
                                           FontSize="16"
                                           TextOptions.TextFormattingMode="Ideal"
                                           TextOptions.TextRenderingMode="ClearType"
                                           WordWrap="True"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           Padding="32,18,32,80"
                                           Background="{DynamicResource PanelBackground}"
                                           Foreground="{DynamicResource TextBrush}"
                                           PreviewMouseWheel="Editor_PreviewMouseWheel"
                                           TextChanged="Editor_TextChanged" />
                    </Grid>
                </Border>

                <GridSplitter x:Name="MainSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                <Border x:Name="PreviewPane" Grid.Column="4" Background="{DynamicResource PanelBackground}" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Background="{DynamicResource PopupSurfaceAltBrush}" LastChildFill="True" Margin="0,0,0,1">
                            <TextBlock Text="原生实时预览" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0">
                                <TextBlock x:Name="CodeStatusText" Text="代码 0" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="FormulaStatusText" Text="公式正常" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="5,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <FlowDocumentScrollViewer x:Name="PreviewViewer" Grid.Row="1"
                                                  IsToolBarVisible="False"
                                                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="True"
                                                  Background="{DynamicResource PanelBackground}"
                                                  PreviewMouseWheel="PreviewViewer_PreviewMouseWheel"
                                                  PreviewMouseDown="PreviewViewer_PreviewMouseDown"
                                                  PreviewKeyDown="PreviewViewer_PreviewKeyDown" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="11,0">
                <TextBlock x:Name="StatusText" Text="已就绪" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="DocumentCountText" Text="1 个文档" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LineCountText" Text="1 行" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="WordCountText" Text="0 字词" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CharacterCountText" Text="0 字符" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
